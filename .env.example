# =============================================================================
# Beediyo Kall — Environment Variables
# Copy this to .env.local and fill in your values
# =============================================================================

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Worldcoin ───────────────────────────────────────────────────────────────
# Get these from https://developer.worldcoin.org/
# Create an app with App Mode = "Mini App", then copy the App ID.
NEXT_PUBLIC_WORLDCOIN_APP_ID=app_xxxxxxxxxxxx

# Dev Portal API key (for server-side payment verification)
# Found in Developer Portal → Team Settings → API Keys
DEV_PORTAL_API_KEY=your-dev-portal-api-key

# Sign-in uses MiniKit.walletAuth() (SIWE): the user signs a message inside
# World App, we verify it server-side and set a signed bk_session cookie.
# No OAuth client id/secret is needed for SIWE.
#
# Optional World ID proof (age/personhood) is separate — see @worldcoin/idkit.

# ─── Payments ────────────────────────────────────────────────────────────────
# Treasury wallet address (where users send WLD payments)
NEXT_PUBLIC_TREASURY_ADDRESS=0x8c5b20653abcb87f6b3a7cb469d8623e94bfb6a1

# ─── Signaling Server (WebRTC) ──────────────────────────────────────────────
NEXT_PUBLIC_SIGNALING_URL=wss://your-signaling-server.com
SIGNALING_PORT=3001
SIGNALING_SECRET=generate-with-openssl-rand-hex-32

# ─── Security ────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Used for the signed bk_session cookie + subscription response signatures.
# If you change it, everyone is signed out — keep it stable.
REQUEST_SIGNING_KEY=generate-a-random-32-byte-hex-string

# Allowed origins (comma-separated for production)
ALLOWED_ORIGINS=https://your-domain.vercel.app

# ─── Dev Mode ────────────────────────────────────────────────────────────────
# Set to 'true' ONLY for local testing outside World App (mock user + fake
# payments, wallet passed as ?wallet= fallback). NEVER true in production.
NEXT_PUBLIC_ALLOW_DEV_MODE=false
